# Copy to .env and fill in real values. Never commit the real .env file.

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key

SALES_POSTGRES_PASSWORD=
CRM_MSSQL_PASSWORD=
FINANCE_ORACLE_PASSWORD=
LEGACY_DB2_PASSWORD=

# Microsoft Purview service principal (client credentials flow), used only
# if purview.enabled is set to true in config.yaml
PURVIEW_TENANT_ID=
PURVIEW_CLIENT_ID=
PURVIEW_CLIENT_SECRET=

# Path to the YAML config used by the MCP server
DB_AGENTS_CONFIG=config.yaml
